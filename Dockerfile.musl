# Statically linked build on a scratch runtime: the binary, a certificate
# bundle, and nothing else. No shell, no package manager, and no CVE surface
# from a base distribution this service never calls into.
#
# TARGETARCH is supplied by buildx. The target triple was hardcoded to x86_64
# in the first version, which silently cross-compiled under emulation on an
# arm64 builder -- slow enough to look like a hang, and wrong for the growing
# number of arm64 deployments.
FROM --platform=$BUILDPLATFORM rust:1.98-alpine AS build
ARG TARGETARCH
RUN apk add --no-cache musl-dev

WORKDIR /src

# Dependencies are built against a stub main so that a source-only change does
# not recompile the imaging tree. libwebp alone is several minutes.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
# The stub must satisfy every target Cargo.toml declares, benches included:
# cargo refuses to parse a manifest naming a target whose file is absent.
RUN mkdir -p src benches \
    && echo 'fn main() {}' > src/main.rs \
    && echo '' > src/lib.rs \
    && echo 'fn main() {}' > benches/render.rs \
    && case "$TARGETARCH" in \
         amd64) echo x86_64-unknown-linux-musl > /target.txt ;; \
         arm64) echo aarch64-unknown-linux-musl > /target.txt ;; \
         *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && rustup target add "$(cat /target.txt)" \
    && cargo build --release --target "$(cat /target.txt)" \
    && rm -rf src benches

COPY . .
# Touched so cargo rebuilds the crate itself rather than reusing the stub's
# fingerprint, which has the same mtime granularity.
RUN touch src/main.rs src/lib.rs \
    && cargo build --release --target "$(cat /target.txt)" \
    && cp "target/$(cat /target.txt)/release/poster-service" /poster-service

FROM scratch
# scratch has no certificate store, and TLS to image.tmdb.org needs one.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /poster-service /poster-service
EXPOSE 8080
USER 65534:65534
ENTRYPOINT ["/poster-service"]
