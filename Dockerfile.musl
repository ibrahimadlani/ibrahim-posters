# Static build. The runtime stage is scratch, so the image contains the binary
# and nothing else: no shell, no package manager, no CVE surface from a base
# distribution that this service never calls into.
FROM rust:1.98-alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY . .
RUN cargo build --release --target x86_64-unknown-linux-musl

FROM scratch
# Needed for TLS to image.tmdb.org; scratch has no certificate store.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /src/target/x86_64-unknown-linux-musl/release/poster-service /poster-service
EXPOSE 8080
USER 65534:65534
ENTRYPOINT ["/poster-service"]
